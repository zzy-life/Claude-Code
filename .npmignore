# Keep npm/git installs focused on runtime files.
# This file also prevents npm from falling back to .gitignore.

.git/
.github/
.vscode/
.idea/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db

coverage/
.nyc_output/
dist-test/
test/
tests/
__tests__/

.env
.env.*
!.env.example
